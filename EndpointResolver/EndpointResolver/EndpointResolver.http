@baseUrl = http://localhost:5187

### All students
GET {{baseUrl}}/api/Students/GetAll

### Student by ID
GET {{baseUrl}}/api/Students/GetOne?id=1

### Create student
POST {{baseUrl}}/api/Students/Create
Content-Type: application/json

{
  "firstName": "Alex",
  "lastName": "Petrov",
  "userName": "alex.p",
  "age": 17
}

### Update student
PUT {{baseUrl}}/api/Students/Update
Content-Type: application/json

{
  "id": 1,
  "firstName": "Alex",
  "lastName": "Petrov",
  "userName": "alex.p",
  "age": 18
}

### Update grade
PATCH {{baseUrl}}/api/Students/UpdateGrade
Content-Type: application/json

{
  "studentId": 1,
  "newGrade": 6
}

### Delete student
DELETE {{baseUrl}}/api/Students/Delete?id=1

### OpenAPI metadata (Development environment only)
GET {{baseUrl}}/openapi/v1.json
